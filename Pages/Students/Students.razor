@page "/students"

@using StudentManagement.Client.Models.Students

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject StudentManagement.Client.Services.Interfaces.IStudentService StudentService
@inject NavigationManager Navigation

@using StudentManagement.Client.Models.Courses

@inject StudentManagement.Client.Services.Interfaces.ICourseService CourseService

<PageTitle>Students</PageTitle>


<MudContainer MaxWidth="MaxWidth.ExtraLarge"
              Class="mt-6">

    <MudGrid Spacing="3"
             AlignItems="AlignItems.Center"
             Class="mb-4">

        <!-- Total Students -->
        <MudItem xs="12" sm="4" md="3">

            <MudCard Class="pa-4 student-total-card">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudIcon Icon="@Icons.Material.Filled.People"
                             Size="Size.Large"
                             Color="Color.Primary" />

                    <MudStack Spacing="0"
                              AlignItems="AlignItems.End">

                        <MudText Typo="Typo.body2">
                            Total Students
                        </MudText>

                        <MudText Typo="Typo.h4">
                            @totalStudents
                        </MudText>

                    </MudStack>

                </MudStack>

            </MudCard>

        </MudItem>


        <!-- Right Side -->
        <MudItem xs="12" sm="8" md="9">

            <div class="admin-dashboard-top-right-section">

                <!-- Search -->
                <div class="student-search">

                    <MudTextField T="string"
                                  @bind-Value="searchText"
                                  Placeholder="Search students..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  Clearable="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="width:100%;" />

                </div>


                <!-- Status Filter -->
                <div class="student-filter">

                    <MudSelect T="string"
                               @bind-Value="statusFilter"
                               Label="Status"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="width:100%;">

                        <MudSelectItem T="string" Value="@("All")">
                            All Status
                        </MudSelectItem>

                        <MudSelectItem T="string" Value="@("Active")">
                            Active
                        </MudSelectItem>

                        <MudSelectItem T="string" Value="@("Inactive")">
                            Inactive
                        </MudSelectItem>

                    </MudSelect>

                </div>


                <!-- Course Filter -->
                <div class="student-filter">

                    <MudSelect T="string"
                               @bind-Value="courseFilter"
                               Label="Course"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="width:100%;">

                        <MudSelectItem T="string" Value="@("All")">
                            All Courses
                        </MudSelectItem>

                        @foreach (var course in courses)
                        {
                            <MudSelectItem T="string"
                                           Value="@course.Id.ToString()">

                                @course.CourseName

                            </MudSelectItem>
                        }

                    </MudSelect>

                </div>


                <!-- Add Student -->
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddStudent"
                           Size="Size.Large"
                           Class="add-student-button">

                    Add Student

                </MudButton>

            </div>

        </MudItem>

    </MudGrid>


    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />

        <MudText Class="mt-2">
            Loading students...
        </MudText>
    }

    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @errorMessage
        </MudAlert>
    }

    else if (students.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No students found.
        </MudAlert>
    }

    else
    {
        <MudTable Items="FilteredStudents"
                  Hover="true"
                  Dense="false"
                  Striped="true">

            <HeaderContent>

                <MudTh>ID</MudTh>

                <MudTh>
                    Admission No.
                </MudTh>

                <MudTh>
                    Name
                </MudTh>

                <MudTh>
                    Email
                </MudTh>

                <MudTh>
                    Gender
                </MudTh>

                <MudTh>
                    Phone
                </MudTh>

                <MudTh>
                    Status
                </MudTh>

            </HeaderContent>


            <RowTemplate>

                <MudTd DataLabel="ID">
                    @context.Id
                </MudTd>

                <MudTd DataLabel="Admission No.">
                    @context.AdmissionNumber
                </MudTd>

                <MudTd DataLabel="Name">
                    @context.FullName
                </MudTd>

                <MudTd DataLabel="Email">
                    @context.Email
                </MudTd>

                <MudTd DataLabel="Gender">
                    @context.Gender
                </MudTd>

                <MudTd DataLabel="Phone">
                    @context.Phone
                </MudTd>

                <MudTd DataLabel="Status">

                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error"
                                 Size="Size.Small">
                            Inactive
                        </MudChip>
                    }

                </MudTd>

                <MudTd DataLabel="Options">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   OnClick="@(() => EditStudent(context.Id))" />
                </MudTd>

            </RowTemplate>

        </MudTable>
    }

</MudContainer>


@code
{
    private List<StudentDto> students = new();

    private bool isLoading = true;

    private string? errorMessage;

    private int totalStudents;

    private string searchText = string.Empty;

    private List<CourseDto> courses = new();

    private string statusFilter = "All";

    private string courseFilter = "All";

    protected override async Task OnInitializedAsync()
    {
        totalStudents = await StudentService.GetTotalStudentsAsync();
        courses =
        await CourseService.GetAllAsync();
        await LoadStudents();
    }

    private void AddStudent()
    {
        Navigation.NavigateTo("/students/add");
    }

    private async Task LoadStudents()
    {
        try
        {
            isLoading = true;

            errorMessage = null;

            students =
                await StudentService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            errorMessage =
                "Students could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<StudentDto> FilteredStudents
    {
        get
        {
            IEnumerable<StudentDto> result = students;


            // Search Filter
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                result = result.Where(s =>
                    s.FirstName.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase) ||

                    s.LastName.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase) ||

                    s.Email.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase) ||

                    s.AdmissionNumber.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase));
            }


            // Status Filter
            if (statusFilter == "Active")
            {
                result =
                    result.Where(s => s.IsActive);
            }
            else if (statusFilter == "Inactive")
            {
                result =
                    result.Where(s => !s.IsActive);
            }


            // Course Filter
            if (courseFilter != "All")
            {
                if (int.TryParse(
                    courseFilter,
                    out int courseId))
                {
                    result =
                        result.Where(
                            s => s.CourseId == courseId);
                }
            }


            return result;
        }
    }

    private void EditStudent(int id)
    {
        Navigation.NavigateTo(
            $"/students/update/{id}");
    }
}

