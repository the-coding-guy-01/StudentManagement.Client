@page "/students"

@using StudentManagement.Client.Models.Courses
@using StudentManagement.Client.Models.Students

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject StudentManagement.Client.Services.Interfaces.IStudentService StudentService
@inject StudentManagement.Client.Services.Interfaces.ICourseService CourseService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Students</PageTitle>

<div class="student-admin-page">
    <div class="student-page-heading">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Groups" Class="student-heading-icon" />
            <div>
                <MudText Typo="Typo.h3" Class="student-page-title">Students</MudText>
                <MudText Typo="Typo.body1" Class="student-page-subtitle">Manage student records</MudText>
            </div>
        </MudStack>
    </div>

    <MudGrid Spacing="2" Class="student-list-toolbar">
        <MudItem xs="12" md="3" Class="total-students-card">
            <div class="student-total-card">
                <div class="student-total-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" />
                </div>
                <div>
                    <MudText Typo="Typo.subtitle1" Class="student-card-label">Total Students</MudText>
                    <MudText Typo="Typo.h3" Class="student-card-value">@totalStudents</MudText>
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" md="9">
            <div class="student-filter-panel">
                <MudTextField T="string"
                              @bind-Value="searchText"
                              Placeholder="Search by admission number, name, or email..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="student-search-input" />

                <MudSelect T="string"
                           @bind-Value="statusFilter"
                           AdornmentIcon="@Icons.Material.Filled.VerifiedUser"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="student-filter-input">
                    <MudSelectItem T="string" Value="@("All")">Status</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Active")">Active</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Inactive")">Inactive</MudSelectItem>
                </MudSelect>

                <MudSelect T="string"
                           @bind-Value="courseFilter"
                           AdornmentIcon="@Icons.Material.Filled.School"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="student-filter-input">
                    <MudSelectItem T="string" Value="@("All")">Course</MudSelectItem>
                    @foreach (var course in courses)
                    {
                        <MudSelectItem T="string" Value="@course.Id.ToString()">@course.CourseName</MudSelectItem>
                    }
                </MudSelect>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddStudent"
                           Class="student-primary-button">
                    Add Student
                </MudButton>
            </div>
        </MudItem>
    </MudGrid>

    <div class="student-table-card">
        @if (isLoading)
        {
            <div class="student-empty-state">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Class="mt-2">Loading students...</MudText>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }
        else if (students.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No students found.</MudAlert>
        }
        else
        {
            <MudTable Items="FilteredStudents"
                      Hover="true"
                      Breakpoint="Breakpoint.Sm"
                      Class="student-data-table">
                <HeaderContent>
                    <MudTh>Admission Number</MudTh>
                    <MudTh>Student Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Gender</MudTh>
                    <MudTh>Phone</MudTh>
                    <MudTh>Enrollment Date</MudTh>
                    <MudTh>Assigned Course</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Admission Number">
                        <span class="student-admission">@context.AdmissionNumber</span>
                    </MudTd>
                    <MudTd DataLabel="Student Name">
                        <div class="student-name-cell">
                            <div class="student-avatar">@GetInitials(context)</div>
                            <span>@context.FullName</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Gender">
                        <span class="student-pill @(context.Gender == "Female" ? "student-pill-female" : "student-pill-male")">
                            @context.Gender
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Phone">@context.Phone</MudTd>
                    <MudTd DataLabel="Enrollment Date">@context.EnrollmentDate.ToString("MMM dd, yyyy")</MudTd>
                    <MudTd DataLabel="Assigned Course">
                        <div class="student-course-cell">
                            <span>@(context.CourseName ?? "Unassigned")</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <span class="student-status @(context.IsActive ? "student-status-active" : "student-status-inactive")">
                            <span></span>
                            @(context.IsActive ? "Active" : "Inactive")
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <div class="student-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Primary"
                                           OnClick="@(() => ViewStudent(context.Id))"
                                           Class="student-action-button" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           OnClick="@(() => EditStudent(context.Id))"
                                           Class="student-action-button" />
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Color="Color.Error"
                                           OnClick="@(() => OpenDeleteDialog(context))"
                                           Class="student-action-button student-action-danger" />
                        </div>
                    </MudTd>
                </RowTemplate>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" />
                </PagerContent>
            </MudTable>
        }
    </div>
</div>

@if (studentToDelete is not null)
{
    <div class="student-modal-backdrop">
        <div class="student-delete-modal">
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           OnClick="CloseDeleteDialog"
                           Class="student-modal-close" />
            <div class="student-delete-icon">
                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" />
            </div>
            <MudText Typo="Typo.h4" Class="student-modal-title">Delete Student?</MudText>
            <div class="student-delete-summary">
                <div class="student-avatar">@GetInitials(studentToDelete)</div>
                <div>
                    <MudText Typo="Typo.h6">@studentToDelete.FullName</MudText>
                    <MudText Typo="Typo.body2">Admission Number: @studentToDelete.AdmissionNumber</MudText>
                </div>
            </div>
            <div class="student-warning-row">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                <MudText>
                    Are you sure you want to delete this student? Deleting may affect related course enrollment information.
                </MudText>
            </div>
            <div class="student-modal-actions">
                <MudButton Variant="Variant.Outlined" Disabled="@isDeleting" OnClick="CloseDeleteDialog">Cancel</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           Disabled="@isDeleting"
                           OnClick="DeleteStudent">
                    Delete Student
                </MudButton>
            </div>
        </div>
    </div>
}

@code
{
    private List<StudentDto> students = new();
    private List<CourseDto> courses = new();
    private bool isLoading = true;
    private bool isDeleting;
    private string? errorMessage;
    private int totalStudents;
    private string searchText = string.Empty;
    private string statusFilter = "All";
    private string courseFilter = "All";
    private StudentDto? studentToDelete;

    protected override async Task OnInitializedAsync()
    {
        totalStudents = await StudentService.GetTotalStudentsAsync();
        courses = await CourseService.GetAllAsync();
        await LoadStudents();
    }

    private void AddStudent()
    {
        Navigation.NavigateTo("/students/add");
    }

    private async Task LoadStudents()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            students = await StudentService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Students could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<StudentDto> FilteredStudents
    {
        get
        {
            IEnumerable<StudentDto> result = students;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                result = result.Where(s =>
                    s.FirstName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    s.LastName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    s.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    s.AdmissionNumber.Contains(searchText, StringComparison.OrdinalIgnoreCase));
            }

            if (statusFilter == "Active")
            {
                result = result.Where(s => s.IsActive);
            }
            else if (statusFilter == "Inactive")
            {
                result = result.Where(s => !s.IsActive);
            }

            if (courseFilter != "All" && int.TryParse(courseFilter, out int courseId))
            {
                result = result.Where(s => s.CourseId == courseId);
            }

            return result;
        }
    }

    private static string GetInitials(StudentDto student)
    {
        var first = string.IsNullOrWhiteSpace(student.FirstName) ? string.Empty : student.FirstName[..1];
        var last = string.IsNullOrWhiteSpace(student.LastName) ? string.Empty : student.LastName[..1];
        return $"{first}{last}".ToUpperInvariant();
    }

    private void ViewStudent(int id)
    {
        Navigation.NavigateTo($"/students/details/{id}");
    }

    private void EditStudent(int id)
    {
        Navigation.NavigateTo($"/students/update/{id}");
    }

    private void OpenDeleteDialog(StudentDto student)
    {
        studentToDelete = student;
    }

    private void CloseDeleteDialog()
    {
        if (!isDeleting)
        {
            studentToDelete = null;
        }
    }

    private async Task DeleteStudent()
    {
        if (studentToDelete is null || isDeleting)
        {
            return;
        }

        try
        {
            isDeleting = true;
            var deleted = await StudentService.DeleteAsync(studentToDelete.Id);

            if (!deleted)
            {
                Snackbar.Add("Student could not be deleted.", Severity.Error);
                return;
            }

            Snackbar.Add("Student deleted successfully.", Severity.Success);
            studentToDelete = null;
            totalStudents = await StudentService.GetTotalStudentsAsync();
            await LoadStudents();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Snackbar.Add("An error occurred while deleting the student.", Severity.Error);
        }
        finally
        {
            isDeleting = false;
        }
    }
}
