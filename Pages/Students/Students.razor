@page "/students"

@using StudentManagement.Client.Models.Students

@inject StudentManagement.Client.Services.Interfaces.IStudentService StudentService
@inject NavigationManager Navigation

<PageTitle>Students</PageTitle>


<MudContainer MaxWidth="MaxWidth.ExtraLarge"
              Class="mt-6">

    <MudGrid Spacing="3" AlignItems="AlignItems.Center" Class="mb-4">

        <!-- Total Students Card -->
        <MudItem xs="12" sm="4" md="3">
            <MudCard Class="pa-4">
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudIcon Icon="@Icons.Material.Filled.People"
                             Size="Size.Large"
                             Color="Color.Primary" />

                    <MudStack Spacing="0"
                              AlignItems="AlignItems.End">

                        <MudText Typo="Typo.body2">
                            Total Students
                        </MudText>

                        <MudText Typo="Typo.h4">
                            @totalStudents
                        </MudText>

                    </MudStack>

                </MudStack>
            </MudCard>
        </MudItem>


        <!-- Search -->
        <div class="admin-dashboard-top-right-section">
            <MudItem xs="12" sm="5" md="6">
                <MudTextField @bind-Value="searchText"
                              Placeholder="Search students..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              FullWidth="true" />
            </MudItem>


            <!-- Add Student -->
            <MudItem xs="12" sm="3" md="3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddStudent"
                           FullWidth="true"
                           Size="Size.Large">

                    Add Student

                </MudButton>
            </MudItem>
        </div>
        

    </MudGrid>


    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />

        <MudText Class="mt-2">
            Loading students...
        </MudText>
    }

    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @errorMessage
        </MudAlert>
    }

    else if (students.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No students found.
        </MudAlert>
    }

    else
    {
        <MudTable Items="FilteredStudents"
                  Hover="true"
                  Dense="false"
                  Striped="true">

            <HeaderContent>

                <MudTh>ID</MudTh>

                <MudTh>
                    Admission No.
                </MudTh>

                <MudTh>
                    Name
                </MudTh>

                <MudTh>
                    Email
                </MudTh>

                <MudTh>
                    Gender
                </MudTh>

                <MudTh>
                    Phone
                </MudTh>

                <MudTh>
                    Status
                </MudTh>

            </HeaderContent>


            <RowTemplate>

                <MudTd DataLabel="ID">
                    @context.Id
                </MudTd>

                <MudTd DataLabel="Admission No.">
                    @context.AdmissionNumber
                </MudTd>

                <MudTd DataLabel="Name">
                    @context.FullName
                </MudTd>

                <MudTd DataLabel="Email">
                    @context.Email
                </MudTd>

                <MudTd DataLabel="Gender">
                    @context.Gender
                </MudTd>

                <MudTd DataLabel="Phone">
                    @context.Phone
                </MudTd>

                <MudTd DataLabel="Status">

                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error"
                                 Size="Size.Small">
                            Inactive
                        </MudChip>
                    }

                </MudTd>

                <MudTd DataLabel="Options">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   OnClick="@(() => EditStudent(context.Id))" />
                </MudTd>

            </RowTemplate>

        </MudTable>
    }

</MudContainer>

<style>
    .admin-dashboard-top-right-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem; /* Adjust the gap as needed */
        padding: 20px;
        border: 1px solid red;
    }
</style>


@code
{
    private List<StudentDto> students = new();

    private bool isLoading = true;

    private string? errorMessage;

    private int totalStudents;

    private string searchText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        totalStudents = await StudentService.GetTotalStudentsAsync();
        await LoadStudents();
    }

    private void AddStudent()
    {
        Navigation.NavigateTo("/students/add");
    }

    private async Task LoadStudents()
    {
        try
        {
            isLoading = true;

            errorMessage = null;

            students =
                await StudentService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            errorMessage =
                "Students could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<StudentDto> FilteredStudents =>
    string.IsNullOrWhiteSpace(searchText)
        ? students
        : students.Where(s =>
            s.FirstName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            s.LastName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            s.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private void EditStudent(int id)
    {
        Navigation.NavigateTo(
            $"/students/update/{id}");
    }
}

