```razor
@page "/student-course-assignment"

@using MudBlazor
@using StudentManagement.Client.Models.Students
@using StudentManagement.Client.Models.Courses
@using StudentManagement.Client.Models.StudentCourses

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject StudentManagement.Client.Services.Interfaces.IStudentService StudentService
@inject StudentManagement.Client.Services.Interfaces.ICourseService CourseService
@inject ISnackbar Snackbar

<PageTitle>Student Course Assignment</PageTitle>


<div class="container-fluid py-4">

    <!-- Header -->
    <div class="mb-4">

        <MudText Typo="Typo.h4">
            Student Course Assignment
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary">
            Drag students into courses to assign them.
            Students can be assigned to multiple courses.
        </MudText>

    </div>


    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

        </div>
    }
    else
    {
        <MudDropContainer T="StudentDragItem"
                          @ref="dropContainer"
                          Items="@studentItems"
                          ItemsSelector="@((item, zone) => item.ZoneIdentifier == zone)"
                          ItemDropped="StudentDropped">

            <ChildContent>

                <div class="row g-4">

                    <!-- ==================================== -->
                    <!-- UNASSIGNED STUDENTS -->
                    <!-- ==================================== -->

                    <div class="col-12 col-md-6 col-lg-4">

                        <div class="card shadow-sm border-0 h-100">

                            <div class="card-header bg-white">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>
                                        <h5 class="mb-0">
                                            Unassigned Students
                                        </h5>

                                        <small class="text-muted">
                                            Students with no courses
                                        </small>
                                    </div>

                                    <MudChip T="int"
                                             Value="@GetUnassignedCount()"
                                             Color="Color.Warning"
                                             Variant="Variant.Filled" />

                                </div>

                            </div>


                            <div class="card-body bg-light">

                                <MudDropZone T="StudentDragItem"
                                             Identifier="unassigned"
                                             Class="p-2 rounded"
                                             Style="min-height:400px;"
                                             AllowReorder="false" />

                            </div>

                        </div>

                    </div>


                    <!-- ==================================== -->
                    <!-- COURSES -->
                    <!-- ==================================== -->

                    @foreach (var course in courses)
                    {
                        <div class="col-12 col-md-6 col-lg-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-white">

                                    <div class="d-flex justify-content-between align-items-start">

                                        <div>

                                            <h5 class="mb-1">
                                                @course.CourseName
                                            </h5>

                                            <small class="text-muted">
                                                @course.CourseCode
                                            </small>

                                        </div>


                                        <MudChip T="int"
                                                 Value="@GetStudentCount(course.Id)"
                                                 Color="Color.Primary"
                                                 Variant="Variant.Filled" />

                                    </div>

                                </div>


                                <div class="card-body">

                                    <MudDropZone T="StudentDragItem"
                                                 Identifier="@GetCourseZone(course.Id)"
                                                 Class="p-2 rounded border"
                                                 Style="min-height:400px;"
                                                 AllowReorder="false" />

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </ChildContent>


            <!-- ======================================== -->
            <!-- STUDENT CARD -->
            <!-- ======================================== -->

            <ItemRenderer>

                <div class="card mb-2 shadow-sm border-0">

                    <div class="card-body p-3">

                        <div class="d-flex align-items-center gap-3">

                            <MudAvatar Color="Color.Primary"
                                       Size="Size.Medium">

                                @GetInitials(context.Student)

                            </MudAvatar>


                            <div class="flex-grow-1">

                                <div class="fw-semibold">

                                    @context.Student.FirstName
                                    @context.Student.LastName

                                </div>

                                <small class="text-muted">

                                    @context.Student.AdmissionNumber

                                </small>

                            </div>


                            @if (context.CourseId.HasValue)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Title="Remove from this course"
                                               OnClick="@(() => RemoveCourse(
                                                   context.Student.Id,
                                                   context.CourseId.Value))" />
                            }


                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                     Color="Color.Secondary" />

                        </div>

                    </div>

                </div>

            </ItemRenderer>

        </MudDropContainer>
    }

</div>


@code {

    private List<StudentDto> students = new();

    private List<CourseDto> courses = new();

    private List<StudentDragItem> studentItems = new();

    private MudDropContainer<StudentDragItem>? dropContainer;

    private bool isLoading = true;


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            students =
                await StudentService.GetAllAsync();

            courses =
                await CourseService.GetAllAsync();


            studentItems = new();


            foreach (var student in students)
            {
                // ==========================================
                // STUDENT HAS NO COURSES
                // ==========================================

                if (student.Courses == null ||
                    student.Courses.Count == 0)
                {
                    studentItems.Add(
                        new StudentDragItem
                        {
                            Student = student,
                            CourseId = null,
                            ZoneIdentifier = "unassigned"
                        });

                    continue;
                }


                // ==========================================
                // STUDENT HAS MULTIPLE COURSES
                // ==========================================

                foreach (var course in student.Courses)
                {
                    studentItems.Add(
                        new StudentDragItem
                        {
                            Student = student,
                            CourseId = course.Id,
                            ZoneIdentifier =
                                GetCourseZone(course.Id)
                        });
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to load data: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task StudentDropped(
        MudItemDropInfo<StudentDragItem> dropInfo)
    {
        var item = dropInfo.Item;

        if (item == null)
        {
            return;
        }


        var newZone =
            dropInfo.DropzoneIdentifier;


        // ==========================================
        // DROPPED INTO SAME COURSE
        // ==========================================

        if (item.ZoneIdentifier == newZone)
        {
            return;
        }


        try
        {
            // ==========================================
            // DROP INTO UNASSIGNED
            // ==========================================

            if (newZone == "unassigned")
            {
                // If the student has a course relationship,
                // remove that specific relationship.

                if (!item.CourseId.HasValue)
                {
                    return;
                }


                var courseId =
                    item.CourseId.Value;


                var success =
                    await StudentService.RemoveCourseAsync(
                        item.Student.Id,
                        courseId);


                if (!success)
                {
                    Snackbar.Add(
                        "Unable to remove student from course.",
                        Severity.Error);

                    return;
                }


                var course =
                    courses.FirstOrDefault(
                        c => c.Id == courseId);


                Snackbar.Add(
                    $"{item.Student.FirstName} removed from {course?.CourseName}.",
                    Severity.Success);


                await LoadData();

                dropContainer?.Refresh();

                return;
            }


            // ==========================================
            // GET TARGET COURSE
            // ==========================================

            var newCourseId =
                GetCourseIdFromZone(newZone);


            if (!newCourseId.HasValue)
            {
                Snackbar.Add(
                    "Invalid course.",
                    Severity.Error);

                return;
            }


            // ==========================================
            // ALREADY ASSIGNED TO THIS COURSE
            // ==========================================

            if (item.CourseId == newCourseId.Value)
            {
                return;
            }


            // ==========================================
            // ASSIGN ADDITIONAL COURSE
            // ==========================================

            var updatedStudent =
                await StudentService.AssignCourseAsync(
                    item.Student.Id,
                    newCourseId.Value);


            if (updatedStudent == null)
            {
                Snackbar.Add(
                    "Unable to assign student.",
                    Severity.Error);

                return;
            }


            var courseToAssign =
                courses.FirstOrDefault(
                    c => c.Id == newCourseId.Value);


            Snackbar.Add(
                $"{item.Student.FirstName} assigned to {courseToAssign?.CourseName}.",
                Severity.Success);


            // ==========================================
            // RELOAD
            // ==========================================

            // We reload because the student can now
            // exist in BOTH course columns.

            await LoadData();

            dropContainer?.Refresh();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Something went wrong: {ex.Message}",
                Severity.Error);

            await LoadData();

            dropContainer?.Refresh();
        }
    }


    private async Task RemoveCourse(
        int studentId,
        int courseId)
    {
        try
        {
            var success =
                await StudentService.RemoveCourseAsync(
                    studentId,
                    courseId);


            if (!success)
            {
                Snackbar.Add(
                    "Unable to remove student from course.",
                    Severity.Error);

                return;
            }


            var course =
                courses.FirstOrDefault(
                    c => c.Id == courseId);


            Snackbar.Add(
                $"Student removed from {course?.CourseName}.",
                Severity.Success);


            await LoadData();

            dropContainer?.Refresh();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Something went wrong: {ex.Message}",
                Severity.Error);

            await LoadData();

            dropContainer?.Refresh();
        }
    }


    private static string GetCourseZone(int courseId)
    {
        return $"course-{courseId}";
    }


    private static int? GetCourseIdFromZone(
        string zone)
    {
        if (!zone.StartsWith("course-"))
        {
            return null;
        }


        var value =
            zone.Replace("course-", "");


        if (int.TryParse(
                value,
                out var courseId))
        {
            return courseId;
        }


        return null;
    }


    private int GetStudentCount(int courseId)
    {
        return studentItems.Count(
            x => x.CourseId == courseId);
    }


    private int GetUnassignedCount()
    {
        return studentItems.Count(
            x => !x.CourseId.HasValue);
    }


    private static string GetInitials(
        StudentDto student)
    {
        var first =
            string.IsNullOrWhiteSpace(student.FirstName)
                ? ""
                : student.FirstName[0].ToString();


        var last =
            string.IsNullOrWhiteSpace(student.LastName)
                ? ""
                : student.LastName[0].ToString();


        return $"{first}{last}".ToUpper();
    }
}
