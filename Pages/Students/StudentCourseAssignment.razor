@page "/student-course-assignment"

@using MudBlazor
@using StudentManagement.Client.Models.Students
@using StudentManagement.Client.Models.Courses
@using StudentManagement.Client.Models.StudentCourses

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject StudentManagement.Client.Services.Interfaces.IStudentService StudentService
@inject StudentManagement.Client.Services.Interfaces.ICourseService CourseService
@inject ISnackbar Snackbar

<PageTitle>Student Course Assignment</PageTitle>


<div class="container-fluid py-4">

    <!-- Header -->
    <div class="mb-4">

        <MudText Typo="Typo.h4">
            Student Course Assignment
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary">
            Drag students and drop them into a course.
        </MudText>

    </div>


    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

        </div>
    }
    else
    {
        <MudDropContainer T="StudentDragItem"
                          @ref="dropContainer"
                          Items="@studentItems"
                          ItemsSelector="@((item, zone) => item.ZoneIdentifier == zone)"
                          ItemDropped="StudentDropped">

            <ChildContent>

                <div class="row g-4">

                    <!-- ==================================== -->
                    <!-- UNASSIGNED STUDENTS -->
                    <!-- ==================================== -->

                    <div class="col-12 col-md-6 col-lg-4">

                        <div class="card shadow-sm border-0 h-100">

                            <div class="card-header bg-white">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>
                                        <h5 class="mb-0">
                                            Unassigned Students
                                        </h5>

                                        <small class="text-muted">
                                            Drag students into a course
                                        </small>
                                    </div>

                                    <MudChip T="int"
                                             Value="@GetUnassignedCount()"
                                             Color="Color.Warning"
                                             Variant="Variant.Filled" />

                                </div>

                            </div>


                            <div class="card-body bg-light">

                                <MudDropZone T="StudentDragItem"
                                             Identifier="unassigned"
                                             Class="p-2 rounded"
                                             Style="min-height:400px;"
                                             AllowReorder="false" />

                            </div>

                        </div>

                    </div>


                    <!-- ==================================== -->
                    <!-- COURSES -->
                    <!-- ==================================== -->
                    @foreach (var course in courses)
                    {
                        <div class="col-12 col-md-6 col-lg-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-white">

                                    <div class="d-flex justify-content-between align-items-start">

                                        <div>

                                            <h5 class="mb-1">
                                                @course.CourseName
                                            </h5>

                                            <small class="text-muted">
                                                @course.CourseCode
                                            </small>

                                        </div>


                                        <MudChip T="int"
                                                 Value="@GetStudentCount(course.Id)"
                                                 Color="Color.Primary"
                                                 Variant="Variant.Filled" />

                                    </div>

                                </div>


                                <div class="card-body">

                                    <MudDropZone T="StudentDragItem"
                                                 Identifier="@GetCourseZone(course.Id)"
                                                 Class="p-2 rounded border"
                                                 Style="min-height:400px;"
                                                 AllowReorder="false" />

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </ChildContent>


            <!-- ======================================== -->
            <!-- STUDENT CARD -->
            <!-- ======================================== -->

            <ItemRenderer>

                <div class="card mb-2 shadow-sm border-0">

                    <div class="card-body p-3">

                        <div class="d-flex align-items-center gap-3">

                            <MudAvatar Color="Color.Primary"
                                       Size="Size.Medium">

                                @GetInitials(context.Student)

                            </MudAvatar>


                            <div class="flex-grow-1">

                                <div class="fw-semibold">

                                    @context.Student.FirstName
                                    @context.Student.LastName

                                </div>

                                <small class="text-muted">

                                    @context.Student.AdmissionNumber

                                </small>

                            </div>


                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                     Color="Color.Secondary" />

                        </div>

                    </div>

                </div>

            </ItemRenderer>

        </MudDropContainer>
    }

</div>


@code {

    private List<StudentDto> students = new();

    private List<CourseDto> courses = new();

    private List<StudentDragItem> studentItems = new();

    private MudDropContainer<StudentDragItem>? dropContainer;

    private bool isLoading = true;


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            students =
                await StudentService.GetAllAsync();

            courses =
                await CourseService.GetAllAsync();

            studentItems = students
                .Select(student => new StudentDragItem
                {
                    Student = student,

                    ZoneIdentifier =
                        student.CourseId.HasValue
                            ? GetCourseZone(student.CourseId.Value)
                            : "unassigned"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to load data: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task StudentDropped(
        MudItemDropInfo<StudentDragItem> dropInfo)
    {
        var item = dropInfo.Item;

        if (item == null)
        {
            return;
        }


        var newZone =
            dropInfo.DropzoneIdentifier;


        // Dropped into same place
        if (item.ZoneIdentifier == newZone)
        {
            return;
        }


        try
        {
            // ==============================
            // REMOVE COURSE
            // ==============================

            if (newZone == "unassigned")
            {
                var success =
                    await StudentService.RemoveCourseAsync(
                        item.Student.Id);


                if (!success)
                {
                    Snackbar.Add(
                        "Unable to remove student from course.",
                        Severity.Error);

                    return;
                }


                item.Student.CourseId = null;
                item.Student.CourseName = null;


                Snackbar.Add(
                    $"{item.Student.FirstName} is now unassigned.",
                    Severity.Success);
            }

            // ==============================
            // ASSIGN COURSE
            // ==============================

            else
            {
                var courseId =
                    GetCourseIdFromZone(newZone);


                if (courseId == null)
                {
                    Snackbar.Add(
                        "Invalid course.",
                        Severity.Error);

                    return;
                }


                var updatedStudent =
                    await StudentService.AssignCourseAsync(
                        item.Student.Id,
                        courseId.Value);


                if (updatedStudent == null)
                {
                    Snackbar.Add(
                        "Unable to assign student.",
                        Severity.Error);

                    return;
                }


                item.Student.CourseId =
                    updatedStudent.CourseId;

                item.Student.CourseName =
                    updatedStudent.CourseName;


                var course =
                    courses.FirstOrDefault(
                        c => c.Id == courseId.Value);


                Snackbar.Add(
                    $"{item.Student.FirstName} assigned to {course?.CourseName}.",
                    Severity.Success);
            }


            // Move the student card
            item.ZoneIdentifier = newZone;


            // Refresh MudBlazor drag/drop
            dropContainer?.Refresh();


            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Something went wrong: {ex.Message}",
                Severity.Error);

            // Reload actual database state if API failed
            await LoadData();

            dropContainer?.Refresh();
        }
    }


    private static string GetCourseZone(int courseId)
    {
        return $"course-{courseId}";
    }


    private static int? GetCourseIdFromZone(
        string zone)
    {
        if (!zone.StartsWith("course-"))
        {
            return null;
        }


        var value =
            zone.Replace("course-", "");


        if (int.TryParse(
                value,
                out var courseId))
        {
            return courseId;
        }


        return null;
    }


    private int GetStudentCount(int courseId)
    {
        return studentItems.Count(
            x => x.ZoneIdentifier ==
                 GetCourseZone(courseId));
    }


    private int GetUnassignedCount()
    {
        return studentItems.Count(
            x => x.ZoneIdentifier ==
                 "unassigned");
    }


    private static string GetInitials(
        StudentDto student)
    {
        var first =
            string.IsNullOrWhiteSpace(student.FirstName)
                ? ""
                : student.FirstName[0].ToString();


        var last =
            string.IsNullOrWhiteSpace(student.LastName)
                ? ""
                : student.LastName[0].ToString();


        return $"{first}{last}".ToUpper();
    }
}