@page "/students/update/{Id:int}"

@using StudentManagement.Client.Models.Students
@using StudentManagement.Client.Services.Interfaces

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject IStudentService StudentService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Edit Student</PageTitle>

<div class="student-admin-page student-form-page">
    <div class="student-page-heading">
        <MudText Typo="Typo.h3" Class="student-page-title">Edit Student</MudText>
        <MudText Typo="Typo.body1" Class="student-page-subtitle">Update student information and details</MudText>
    </div>

    @if (isLoading)
    {
        <div class="student-form-card student-form-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-2">Loading student details...</MudText>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <MudAlert Severity="Severity.Success" Class="student-form-success">
                @successMessage
            </MudAlert>
        }

        <div class="student-form-card">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
            }

            <EditForm Model="@student" OnValidSubmit="SaveStudent">
                <DataAnnotationsValidator />

                <MudGrid Spacing="4">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="Admission Number"
                                      Value="@admissionNumber"
                                      ReadOnly="true"
                                      Variant="Variant.Outlined"
                                      HelperText="Admission number is system generated and cannot be changed."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock"
                                      Class="student-form-input student-readonly-input" />
                    </MudItem>

                    <MudItem xs="12" md="6"></MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="First Name"
                                      @bind-Value="student.FirstName"
                                      For="@(() => student.FirstName)"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="First name is required."
                                      MaxLength="100"
                                      Counter="100"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person"
                                      Class="student-form-input" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="Last Name"
                                      @bind-Value="student.LastName"
                                      For="@(() => student.LastName)"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Last name is required."
                                      MaxLength="100"
                                      Counter="100"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person"
                                      Class="student-form-input" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="Email"
                                      @bind-Value="student.Email"
                                      For="@(() => student.Email)"
                                      InputType="InputType.Email"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Email is required."
                                      HelperText="Enter a valid email address."
                                      MaxLength="150"
                                      Counter="150"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      Class="student-form-input" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudDatePicker Label="Enrollment Date"
                                       @bind-Date="enrollmentDate"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       RequiredError="Enrollment date is required."
                                       HelperText="Select the enrollment date."
                                       AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                                       Class="student-form-input" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudDatePicker Label="Date of Birth"
                                       @bind-Date="student.DateOfBirth"
                                       Variant="Variant.Outlined"
                                       HelperText="Select the student's date of birth."
                                       AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                                       Class="student-form-input" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="string"
                                   Label="Gender"
                                   @bind-Value="student.Gender"
                                   Variant="Variant.Outlined"
                                   HelperText="Select the student's gender."
                                   AdornmentIcon="@Icons.Material.Filled.Wc"
                                   Class="student-form-input">
                            <MudSelectItem T="string" Value="@("Male")">Male</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Female")">Female</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Other")">Other</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="Phone Number"
                                      @bind-Value="student.Phone"
                                      For="@(() => student.Phone)"
                                      Variant="Variant.Outlined"
                                      HelperText="Enter a valid phone number."
                                      MaxLength="20"
                                      Counter="20"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Phone"
                                      Class="student-form-input" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="bool"
                                   Label="Student Status"
                                   @bind-Value="student.IsActive"
                                   Variant="Variant.Outlined"
                                   HelperText="Select the student's status."
                                   AdornmentIcon="@Icons.Material.Filled.VerifiedUser"
                                   Class="student-form-input">
                            <MudSelectItem T="bool" Value="true">Active</MudSelectItem>
                            <MudSelectItem T="bool" Value="false">Inactive</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-6" />

                <div class="student-form-actions">
                    <MudButton Variant="Variant.Outlined"
                               Disabled="@isSaving"
                               OnClick="Cancel"
                               Class="student-secondary-button">
                        Cancel
                    </MudButton>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@isSaving"
                               Class="student-primary-button">
                        @(isSaving ? "Saving..." : "Save Changes")
                    </MudButton>
                </div>
            </EditForm>
        </div>
    }
</div>

@code
{
    [Parameter]
    public int Id { get; set; }

    private UpdateStudentDto student = new();
    private string admissionNumber = string.Empty;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    private DateTime? enrollmentDate
    {
        get => student.EnrollmentDate;
        set
        {
            if (value.HasValue)
            {
                student.EnrollmentDate = value.Value;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStudent();
    }

    private async Task LoadStudent()
    {
        try
        {
            isLoading = true;

            var existingStudent = await StudentService.GetByIdAsync(Id);

            if (existingStudent == null)
            {
                errorMessage = "Student not found.";
                return;
            }

            admissionNumber = existingStudent.AdmissionNumber;
            student = new UpdateStudentDto
            {
                FirstName = existingStudent.FirstName,
                LastName = existingStudent.LastName,
                Email = existingStudent.Email,
                DateOfBirth = existingStudent.DateOfBirth,
                Gender = existingStudent.Gender,
                Phone = existingStudent.Phone,
                EnrollmentDate = existingStudent.EnrollmentDate,
                IsActive = existingStudent.IsActive
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Student details could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveStudent()
    {
        if (isSaving)
        {
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            var updatedStudent = await StudentService.UpdateAsync(Id, student);

            if (updatedStudent == null)
            {
                errorMessage = "Student could not be updated.";
                return;
            }

            successMessage = "Student updated successfully";
            Snackbar.Add($"Student updated successfully. Admission No: {updatedStudent.AdmissionNumber}", Severity.Success);
            Navigation.NavigateTo("/students");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "An error occurred while updating the student.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/students");
    }
}
