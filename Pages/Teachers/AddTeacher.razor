@page "/teachers/add"

@using Microsoft.AspNetCore.Authorization
@using StudentManagement.Client.Models.Teachers
@using StudentManagement.Client.Services.Interfaces

@attribute [Authorize(Roles = "Admin")]

@inject ITeacherService TeacherService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar


<PageTitle>Add Teacher</PageTitle>


<div class="container-fluid py-4">

    <!-- =============================== -->
    <!-- HEADER -->
    <!-- =============================== -->

    <div class="mb-4">

        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="Cancel"
                   Class="mb-2">

            Back to Teachers

        </MudButton>


        <h2 class="fw-bold mb-1">
            Add Teacher
        </h2>


        <p class="text-muted mb-0">
            Create a new teacher account
        </p>

    </div>



    <!-- =============================== -->
    <!-- FORM CARD -->
    <!-- =============================== -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4 p-md-5">

            <EditForm Model="@teacher"
                      OnValidSubmit="SaveTeacher">

                <DataAnnotationsValidator />


                <!-- =============================== -->
                <!-- PERSONAL INFORMATION -->
                <!-- =============================== -->

                <div class="mb-4">


                    <!-- Section Header -->

                    <div class="mb-4">

                        <h5 class="fw-bold mb-1">
                            Personal Information
                        </h5>

                        <p class="text-muted small mb-0">
                            Enter the teacher's personal details
                        </p>

                    </div>



                    <div class="row g-4">


                        <!-- First Name -->

                        <div class="col-12 col-md-6">

                            <MudTextField T="string"
                                          Label="First Name"
                                          @bind-Value="teacher.FirstName"
                                          For="@(() => teacher.FirstName)"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Class="w-100" />

                        </div>



                        <!-- Last Name -->

                        <div class="col-12 col-md-6">

                            <MudTextField T="string"
                                          Label="Last Name"
                                          @bind-Value="teacher.LastName"
                                          For="@(() => teacher.LastName)"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Class="w-100" />

                        </div>



                        <!-- Email -->

                        <div class="col-12 col-md-6">

                            <MudTextField T="string"
                                          Label="Email"
                                          @bind-Value="teacher.Email"
                                          For="@(() => teacher.Email)"
                                          InputType="InputType.Email"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Email"
                                          Class="w-100" />

                        </div>



                        <!-- Phone -->

                        <div class="col-12 col-md-6">

                            <MudTextField T="string"
                                          Label="Phone"
                                          @bind-Value="teacher.Phone"
                                          For="@(() => teacher.Phone)"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Phone"
                                          Class="w-100" />

                        </div>



                        <!-- Date of Birth -->

                        <div class="col-12 col-md-6">

                            <MudDatePicker Label="Date of Birth"
                                           @bind-Date="teacher.DateOfBirth"
                                           Variant="Variant.Outlined"
                                           Class="w-100" />

                        </div>



                        <!-- Gender -->

                        <div class="col-12 col-md-6">

                            <MudSelect T="string"
                                       Label="Gender"
                                       @bind-Value="teacher.Gender"
                                       For="@(() => teacher.Gender)"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       Class="w-100">

                                <MudSelectItem T="string"
                                               Value="@("Male")">
                                    Male
                                </MudSelectItem>

                                <MudSelectItem T="string"
                                               Value="@("Female")">
                                    Female
                                </MudSelectItem>

                                <MudSelectItem T="string"
                                               Value="@("Other")">
                                    Other
                                </MudSelectItem>

                            </MudSelect>

                        </div>


                    </div>

                </div>



                <!-- Divider -->

                <hr class="my-5 text-muted" />



                <!-- =============================== -->
                <!-- EMPLOYMENT INFORMATION -->
                <!-- =============================== -->

                <div class="mb-5">


                    <div class="mb-4">

                        <h5 class="fw-bold mb-1">
                            Employment Information
                        </h5>

                        <p class="text-muted small mb-0">
                            Enter the teacher's employment details
                        </p>

                    </div>



                    <div class="row g-4">


                        <!-- Join Date -->

                        <div class="col-12 col-md-6">

                            <MudDatePicker Label="Join Date"
                                           @bind-Date="teacher.JoinDate"
                                           Variant="Variant.Outlined"
                                           Required="true"
                                           Class="w-100" />

                        </div>


                    </div>

                </div>



                <!-- =============================== -->
                <!-- ACTION BUTTONS -->
                <!-- =============================== -->

                <div class="d-flex flex-column flex-sm-row
                            justify-content-end
                            gap-3
                            pt-3
                            border-top">


                    <!-- Cancel -->

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Disabled="@isSaving"
                               OnClick="Cancel"
                               Class="px-4">

                        Cancel

                    </MudButton>



                    <!-- Save -->

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@isSaving"
                               Class="px-4">

                        @if (isSaving)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Class="me-2" />

                            <span>
                                Saving...
                            </span>
                        }
                        else
                        {
                            <span>
                                Add Teacher
                            </span>
                        }

                    </MudButton>


                </div>


            </EditForm>

        </div>

    </div>

</div>



@code {

    private CreateTeacherDto teacher =
        new()
        {
            JoinDate = DateTime.Today
        };


    private bool isSaving;


    private async Task SaveTeacher()
    {
        if (isSaving)
        {
            return;
        }

        try
        {
            isSaving = true;


            var result =
                await TeacherService.CreateAsync(
                    teacher);


            if (result == null)
            {
                Snackbar.Add(
                    "Unable to create teacher.",
                    Severity.Error);

                return;
            }


            Snackbar.Add(
                "Teacher added successfully.",
                Severity.Success);


            Navigation.NavigateTo("/teachers");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Snackbar.Add(
                "An error occurred while creating the teacher.",
                Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }


    private void Cancel()
    {
        Navigation.NavigateTo("/teachers");
    }

}