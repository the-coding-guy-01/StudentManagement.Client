@page "/teachers"

@using Microsoft.AspNetCore.Authorization
@using StudentManagement.Client.Models.Teachers
@using StudentManagement.Client.Services.Interfaces

@attribute [Authorize]

@inject ITeacherService TeacherService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar


<PageTitle>Teachers</PageTitle>


<div class="container-fluid py-4">

    <!-- =============================== -->
    <!-- HEADER -->
    <!-- =============================== -->

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Teachers
        </h2>

        <p class="text-muted mb-0">
            Manage teachers registered in the system
        </p>

    </div>



    <!-- =============================== -->
    <!-- TOP SECTION -->
    <!-- =============================== -->

    <div class="row g-3 align-items-stretch mb-4">


        <!-- TOTAL TEACHERS -->

        <div class="col-12 col-md-4 col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3">

                        <!-- Icon -->

                        <div class="rounded-circle
                                    bg-primary
                                    bg-opacity-10
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    flex-shrink-0"
                             style="width:55px; height:55px;">

                            <MudIcon Icon="@Icons.Material.Filled.School"
                                     Size="Size.Large"
                                     Color="Color.Primary" />

                        </div>


                        <!-- Count -->

                        <div>

                            <div class="text-muted small mb-1">
                                Total Teachers
                            </div>

                            <h3 class="fw-bold mb-0">
                                @totalTeachers
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- SEARCH + ADD TEACHER -->

        <div class="col-12 col-md-8 col-lg-9">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-3 p-md-4">

                    <div class="d-flex
                                flex-column
                                flex-md-row
                                align-items-md-center
                                justify-content-end
                                gap-3
                                h-100">


                        <!-- Search -->

                        <div class="flex-grow-1 w-100">

                            <MudTextField T="string"
                                          @bind-Value="searchText"
                                          Placeholder="Search teachers..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Immediate="true"
                                          Clearable="true"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="w-100" />

                        </div>


                        <!-- Add Teacher -->

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Large"
                                   OnClick="AddTeacher"
                                   Class="flex-shrink-0">

                            Add Teacher

                        </MudButton>


                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =============================== -->
    <!-- TEACHERS TABLE CARD -->
    <!-- =============================== -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">


            @if (isLoading)
            {
                <!-- Loading -->

                <div class="d-flex
                                flex-column
                                justify-content-center
                                align-items-center
                                gap-3
                                py-5"
                     style="min-height:350px;">

                    <MudProgressCircular Indeterminate="true"
                                         Color="Color.Primary" />

                    <span class="text-muted">
                        Loading teachers...
                    </span>

                </div>
            }
            else if (!FilteredTeachers.Any())
            {
                <!-- Empty State -->

                <div class="d-flex
                                flex-column
                                justify-content-center
                                align-items-center
                                text-center
                                py-5 px-3"
                     style="min-height:350px;">

                    <div class="mb-3">

                        <MudIcon Icon="@Icons.Material.Filled.PersonOff"
                                 Size="Size.Large"
                                 Color="Color.Secondary" />

                    </div>


                    <h5 class="fw-bold mb-2">
                        No teachers found
                    </h5>


                    <p class="text-muted mb-0">

                        @if (string.IsNullOrWhiteSpace(searchText))
                        {
                            <span>
                                Add your first teacher to get started.
                            </span>
                        }
                        else
                        {
                            <span>
                                No teachers match your search.
                            </span>
                        }

                    </p>

                </div>
            }
            else
            {
                <!-- =============================== -->
                <!-- TABLE -->
                <!-- =============================== -->

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <!-- Header -->

                        <thead class="table-light">

                            <tr>

                                <th class="px-4 py-3">
                                    ID
                                </th>

                                <th class="px-4 py-3">
                                    Name
                                </th>

                                <th class="px-4 py-3">
                                    Email
                                </th>

                                <th class="px-4 py-3">
                                    Phone
                                </th>

                                <th class="px-4 py-3">
                                    Gender
                                </th>

                                <th class="px-4 py-3">
                                    Join Date
                                </th>

                                <th class="px-4 py-3">
                                    Status
                                </th>

                                <th class="px-4 py-3 text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <!-- Body -->

                        <tbody>

                            @foreach (var teacher in FilteredTeachers)
                            {
                                <tr>


                                    <!-- ID -->

                                    <td class="px-4 py-3">

                                        <span class="text-muted">
                                            #@teacher.Id
                                        </span>

                                    </td>



                                    <!-- Name -->

                                    <td class="px-4 py-3">

                                        <div class="d-flex
                                                            align-items-center
                                                            gap-3">

                                            <MudAvatar Color="Color.Primary"
                                                       Size="Size.Small">

                                                @GetInitials(teacher)

                                            </MudAvatar>


                                            <div>

                                                <div class="fw-semibold">

                                                    @teacher.FirstName
                                                    @teacher.LastName

                                                </div>

                                            </div>

                                        </div>

                                    </td>



                                    <!-- Email -->

                                    <td class="px-4 py-3">

                                        <span class="text-muted">
                                            @teacher.Email
                                        </span>

                                    </td>



                                    <!-- Phone -->

                                    <td class="px-4 py-3">

                                        <span>
                                            @teacher.Phone
                                        </span>

                                    </td>



                                    <!-- Gender -->

                                    <td class="px-4 py-3">

                                        @teacher.Gender

                                    </td>



                                    <!-- Join Date -->

                                    <td class="px-4 py-3">

                                        @teacher.JoinDate.ToString("dd MMM yyyy")

                                    </td>



                                    <!-- Status -->

                                    <td class="px-4 py-3">

                                        @if (teacher.IsActive)
                                        {
                                            <span class="badge
                                                                     rounded-pill
                                                                     bg-success
                                                                     bg-opacity-10
                                                                     text-success
                                                                     px-3
                                                                     py-2">

                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                                     rounded-pill
                                                                     bg-danger
                                                                     bg-opacity-10
                                                                     text-danger
                                                                     px-3
                                                                     py-2">

                                                Inactive

                                            </span>
                                        }

                                    </td>



                                    <!-- Actions -->

                                    <td class="px-4 py-3">

                                        <div class="d-flex
                                                            justify-content-center
                                                            align-items-center
                                                            gap-1">

                                            <!-- Edit -->

                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => EditTeacher(teacher.Id))" />


                                            <!-- Delete -->

                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => DeleteTeacher(teacher))" />

                                        </div>

                                    </td>


                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>



@code {

    private List<TeacherDto> teachers = new();

    private bool isLoading = true;

    private string searchText = string.Empty;

    private int totalTeachers;



    // =========================================
    // FILTER TEACHERS
    // =========================================

    private IEnumerable<TeacherDto> FilteredTeachers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
            {
                return teachers;
            }


            var search =
                searchText.Trim();


            return teachers.Where(t =>

                t.Id
                    .ToString()
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)

                ||

                t.FirstName
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)

                ||

                t.LastName
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)

                ||

                $"{t.FirstName} {t.LastName}"
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)

                ||

                t.Email
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)

                ||

                t.Phone
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)

            );
        }
    }



    // =========================================
    // LOAD PAGE
    // =========================================

    protected override async Task OnInitializedAsync()
    {
        await LoadTeachers();
    }



    // =========================================
    // LOAD TEACHERS
    // =========================================

    private async Task LoadTeachers()
    {
        try
        {
            isLoading = true;


            teachers =
                await TeacherService.GetAllAsync();


            totalTeachers =
                await TeacherService.GetTotalTeachersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);


            Snackbar.Add(
                "Failed to load teachers.",
                Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }



    // =========================================
    // ADD TEACHER
    // =========================================

    private void AddTeacher()
    {
        Navigation.NavigateTo(
            "/teachers/add");
    }



    // =========================================
    // EDIT TEACHER
    // =========================================

    private void EditTeacher(int id)
    {
        Navigation.NavigateTo(
            $"/teachers/edit/{id}");
    }



    // =========================================
    // DELETE TEACHER
    // =========================================

    private async Task DeleteTeacher(
        TeacherDto teacher)
    {
        var confirmed =
            await DialogService.ShowMessageBoxAsync(
                "Delete Teacher",
                $"Are you sure you want to delete {teacher.FirstName} {teacher.LastName}?",
                yesText: "Delete",
                cancelText: "Cancel");


        if (confirmed != true)
        {
            return;
        }


        try
        {
            var deleted =
                await TeacherService.DeleteAsync(
                    teacher.Id);


            if (!deleted)
            {
                Snackbar.Add(
                    "Unable to delete teacher.",
                    Severity.Error);

                return;
            }


            Snackbar.Add(
                "Teacher deleted successfully.",
                Severity.Success);


            await LoadTeachers();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);


            Snackbar.Add(
                "An error occurred while deleting the teacher.",
                Severity.Error);
        }
    }



    // =========================================
    // TEACHER INITIALS
    // =========================================

    private static string GetInitials(
        TeacherDto teacher)
    {
        var first =
            string.IsNullOrWhiteSpace(
                teacher.FirstName)
                    ? ""
                    : teacher.FirstName[..1];


        var last =
            string.IsNullOrWhiteSpace(
                teacher.LastName)
                    ? ""
                    : teacher.LastName[..1];


        return $"{first}{last}".ToUpper();
    }

}