@page "/teachers/edit/{Id:int}"

@using Microsoft.AspNetCore.Authorization
@using StudentManagement.Client.Models.Teachers
@using StudentManagement.Client.Services.Interfaces

@attribute [Authorize]

@inject ITeacherService TeacherService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar


<PageTitle>Edit Teacher</PageTitle>


<div class="container-fluid py-4">

    @if (isLoading)
    {
        <!-- =============================== -->
        <!-- LOADING -->
        <!-- =============================== -->

        <div class="d-flex flex-column
                        justify-content-center
                        align-items-center
                        gap-3"
             style="min-height:500px;">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

            <span class="text-muted">
                Loading teacher...
            </span>

        </div>
    }
    else if (teacher == null)
    {
        <!-- =============================== -->
        <!-- TEACHER NOT FOUND -->
        <!-- =============================== -->

        <div class="d-flex justify-content-center align-items-center"
             style="min-height:500px;">

            <div class="card border-0 shadow-sm rounded-4 text-center"
                 style="max-width:500px; width:100%;">

                <div class="card-body p-5">

                    <div class="mb-3">

                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                                 Size="Size.Large"
                                 Color="Color.Error" />

                    </div>

                    <h4 class="fw-bold mb-2">
                        Teacher not found
                    </h4>

                    <p class="text-muted mb-4">
                        The teacher you are looking for could not be found.
                    </p>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="Cancel">

                        Back to Teachers

                    </MudButton>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- =============================== -->
        <!-- PAGE HEADER -->
        <!-- =============================== -->

        <div class="mb-4">

            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="Cancel"
                       Class="mb-2">

                Back to Teachers

            </MudButton>


            <h2 class="fw-bold mb-1">
                Edit Teacher
            </h2>


            <p class="text-muted mb-0">
                Update teacher information
            </p>

        </div>



        <!-- =============================== -->
        <!-- FORM CARD -->
        <!-- =============================== -->

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4 p-md-5">

                <EditForm Model="@teacher"
                          OnValidSubmit="UpdateTeacher">

                    <DataAnnotationsValidator />


                    <!-- =============================== -->
                    <!-- TEACHER SUMMARY -->
                    <!-- =============================== -->

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <MudAvatar Color="Color.Primary"
                                   Size="Size.Large">

                            @GetInitials()

                        </MudAvatar>


                        <div>

                            <h5 class="fw-bold mb-1">

                                @teacher.FirstName
                                @teacher.LastName

                            </h5>

                            <p class="text-muted small mb-0">
                                Teacher ID: #@Id
                            </p>

                        </div>

                    </div>



                    <hr class="my-4" />



                    <!-- =============================== -->
                    <!-- PERSONAL INFORMATION -->
                    <!-- =============================== -->

                    <div class="mb-5">


                        <!-- Section heading -->

                        <div class="mb-4">

                            <h5 class="fw-bold mb-1">
                                Personal Information
                            </h5>

                            <p class="text-muted small mb-0">
                                Update the teacher's personal details
                            </p>

                        </div>



                        <div class="row g-4">


                            <!-- First Name -->

                            <div class="col-12 col-md-6">

                                <MudTextField T="string"
                                              Label="First Name"
                                              @bind-Value="teacher.FirstName"
                                              For="@(() => teacher.FirstName)"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Class="w-100" />

                            </div>



                            <!-- Last Name -->

                            <div class="col-12 col-md-6">

                                <MudTextField T="string"
                                              Label="Last Name"
                                              @bind-Value="teacher.LastName"
                                              For="@(() => teacher.LastName)"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Class="w-100" />

                            </div>



                            <!-- Email -->

                            <div class="col-12 col-md-6">

                                <MudTextField T="string"
                                              Label="Email"
                                              @bind-Value="teacher.Email"
                                              For="@(() => teacher.Email)"
                                              InputType="InputType.Email"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Email"
                                              Class="w-100" />

                            </div>



                            <!-- Phone -->

                            <div class="col-12 col-md-6">

                                <MudTextField T="string"
                                              Label="Phone"
                                              @bind-Value="teacher.Phone"
                                              For="@(() => teacher.Phone)"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Phone"
                                              Class="w-100" />

                            </div>



                            <!-- Date of Birth -->

                            <div class="col-12 col-md-6">

                                <MudDatePicker Label="Date of Birth"
                                               @bind-Date="teacher.DateOfBirth"
                                               Variant="Variant.Outlined"
                                               Class="w-100" />

                            </div>



                            <!-- Gender -->

                            <div class="col-12 col-md-6">

                                <MudSelect T="string"
                                           Label="Gender"
                                           @bind-Value="teacher.Gender"
                                           For="@(() => teacher.Gender)"
                                           Variant="Variant.Outlined"
                                           Required="true"
                                           Class="w-100">

                                    <MudSelectItem T="string"
                                                   Value="@("Male")">
                                        Male
                                    </MudSelectItem>

                                    <MudSelectItem T="string"
                                                   Value="@("Female")">
                                        Female
                                    </MudSelectItem>

                                    <MudSelectItem T="string"
                                                   Value="@("Other")">
                                        Other
                                    </MudSelectItem>

                                </MudSelect>

                            </div>


                        </div>

                    </div>



                    <hr class="my-5" />



                    <!-- =============================== -->
                    <!-- EMPLOYMENT INFORMATION -->
                    <!-- =============================== -->

                    <div class="mb-5">


                        <div class="mb-4">

                            <h5 class="fw-bold mb-1">
                                Employment Information
                            </h5>

                            <p class="text-muted small mb-0">
                                Manage joining date and teacher status
                            </p>

                        </div>



                        <div class="row g-4">


                            <!-- Join Date -->

                            <div class="col-12 col-md-6">

                                <MudDatePicker Label="Join Date"
                                               @bind-Date="teacher.JoinDate"
                                               Variant="Variant.Outlined"
                                               Required="true"
                                               Class="w-100" />

                            </div>



                            <!-- Active Status -->

                            <div class="col-12 col-md-6">

                                <div class="border rounded-3
                                                p-3
                                                bg-light
                                                h-100
                                                d-flex
                                                flex-column
                                                justify-content-center">

                                    <MudSwitch T="bool"
                                               @bind-Value="teacher.IsActive"
                                               Color="Color.Primary"
                                               Label="Active Teacher" />

                                    <small class="text-muted mt-1">

                                        Disable this if the teacher
                                        is no longer active.

                                    </small>

                                </div>

                            </div>


                        </div>

                    </div>



                    <!-- =============================== -->
                    <!-- ACTION BUTTONS -->
                    <!-- =============================== -->

                    <div class="d-flex
                                    flex-column
                                    flex-sm-row
                                    justify-content-end
                                    gap-3
                                    pt-4
                                    border-top">


                        <!-- Cancel -->

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Disabled="@isSaving"
                                   OnClick="Cancel"
                                   Class="px-4">

                            Cancel

                        </MudButton>



                        <!-- Save Changes -->

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@isSaving"
                                   Class="px-4">

                            @if (isSaving)
                            {
                                <MudProgressCircular Size="Size.Small"
                                                     Indeterminate="true"
                                                     Class="me-2" />

                                <span>
                                    Saving...
                                </span>
                            }
                            else
                            {
                                <span>
                                    Save Changes
                                </span>
                            }

                        </MudButton>


                    </div>


                </EditForm>

            </div>

        </div>

    }

</div>



@code {

    [Parameter]
    public int Id { get; set; }


    private UpdateTeacherDto? teacher;

    private bool isLoading = true;

    private bool isSaving;



    // =========================================
    // LOAD TEACHER
    // =========================================

    protected override async Task OnParametersSetAsync()
    {
        await LoadTeacher();
    }


    private async Task LoadTeacher()
    {
        try
        {
            isLoading = true;


            var existingTeacher =
                await TeacherService.GetByIdAsync(Id);


            if (existingTeacher == null)
            {
                teacher = null;

                return;
            }


            teacher =
                new UpdateTeacherDto
                {
                    FirstName =
                        existingTeacher.FirstName,

                    LastName =
                        existingTeacher.LastName,

                    Email =
                        existingTeacher.Email,

                    DateOfBirth =
                        existingTeacher.DateOfBirth,

                    Gender =
                        existingTeacher.Gender,

                    Phone =
                        existingTeacher.Phone,

                    JoinDate =
                        existingTeacher.JoinDate,

                    IsActive =
                        existingTeacher.IsActive
                };
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Snackbar.Add(
                "Failed to load teacher.",
                Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }



    // =========================================
    // UPDATE TEACHER
    // =========================================

    private async Task UpdateTeacher()
    {
        if (teacher == null || isSaving)
        {
            return;
        }


        try
        {
            isSaving = true;


            var result =
                await TeacherService.UpdateAsync(
                    Id,
                    teacher);


            if (result == null)
            {
                Snackbar.Add(
                    "Unable to update teacher.",
                    Severity.Error);

                return;
            }


            Snackbar.Add(
                "Teacher updated successfully.",
                Severity.Success);


            Navigation.NavigateTo("/teachers");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Snackbar.Add(
                "An error occurred while updating the teacher.",
                Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }



    // =========================================
    // CANCEL
    // =========================================

    private void Cancel()
    {
        Navigation.NavigateTo("/teachers");
    }



    // =========================================
    // TEACHER INITIALS
    // =========================================

    private string GetInitials()
    {
        if (teacher == null)
        {
            return "";
        }


        var first =
            string.IsNullOrWhiteSpace(
                teacher.FirstName)
                    ? ""
                    : teacher.FirstName[..1];


        var last =
            string.IsNullOrWhiteSpace(
                teacher.LastName)
                    ? ""
                    : teacher.LastName[..1];


        return $"{first}{last}".ToUpper();
    }

}