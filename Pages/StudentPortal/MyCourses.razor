@page "/student/my-courses"

@layout StudentLayout

@using Microsoft.AspNetCore.Authorization
@using StudentManagement.Client.Models.StudentPortal
@using StudentManagement.Client.Services.Interfaces

@attribute [Authorize(Roles = "Student")]

@inject IStudentCourseService StudentCourseService
@inject ISnackbar Snackbar


<PageTitle>My Courses</PageTitle>


@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center"
         style="min-height:400px;">

        <MudProgressCircular Indeterminate="true"
                             Size="Size.Large"
                             Color="Color.Primary" />

    </div>
}
else
{
    <div class="my-courses-page">

        <!-- PAGE TITLE -->

        <MudText Typo="Typo.h4"
                 Class="font-weight-bold">

            My Courses

        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary"
                 Class="mb-5">

            View your enrolled course and course information

        </MudText>


        @if (course == null)
        {
            <!-- NO COURSE -->

            <MudPaper Elevation="0"
                      Class="p-5 bg-white border rounded-4 shadow-sm">

                <div class="text-center py-5">

                    <div class="course-empty-icon mx-auto mb-4">

                        <MudIcon Icon="@Icons.Material.Filled.School"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

                    </div>

                    <MudText Typo="Typo.h5"
                             Class="fw-bold mb-2">

                        No Course Assigned

                    </MudText>

                    <MudText Typo="Typo.body1"
                             Color="Color.Secondary">

                        You haven't been assigned to a course yet.

                    </MudText>

                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary"
                             Class="mt-1">

                        Please contact the administrator for more
                        information.

                    </MudText>

                </div>

            </MudPaper>
        }
        else
        {
            <!-- COURSE CARD -->

            <MudPaper Elevation="0"
                      Class="p-4 p-md-5 bg-white border rounded-4 shadow-sm">

                <!-- COURSE HEADER -->

                <div class="d-flex flex-column flex-md-row
                            justify-content-between
                            align-items-md-start gap-3 mb-4">

                    <div>

                        <div class="d-flex align-items-center gap-2 mb-2">

                            <MudIcon Icon="@Icons.Material.Filled.School"
                                     Color="Color.Primary" />

                            <MudText Typo="Typo.subtitle1"
                                     Color="Color.Primary"
                                     Class="fw-bold">

                                @course.CourseCode

                            </MudText>

                        </div>


                        <MudText Typo="Typo.h4"
                                 Class="fw-bold mb-2">

                            @course.CourseName

                        </MudText>


                        <MudText Typo="Typo.body1"
                                 Color="Color.Secondary">

                            @(string.IsNullOrWhiteSpace(
                                course.Description)
                                ? "No course description available."
                                : course.Description)

                        </MudText>

                    </div>


                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(course.IsActive
                                 ? Color.Success
                                 : Color.Error)">

                        @(course.IsActive
                            ? "Active"
                            : "Inactive")

                    </MudChip>

                </div>


                <MudDivider Class="mb-4" />


                <!-- COURSE INFORMATION -->

                <div class="row g-4">

                    <!-- CREDITS -->

                    <div class="col-12 col-md-4">

                        <div class="course-info-box">

                            <div class="course-info-icon">

                                <MudIcon Icon="@Icons.Material.Filled.Grade"
                                         Color="Color.Primary" />

                            </div>

                            <div>

                                <MudText Typo="Typo.body2"
                                         Color="Color.Secondary">

                                    Credits

                                </MudText>

                                <MudText Typo="Typo.h6"
                                         Class="fw-bold">

                                    @course.Credits

                                </MudText>

                            </div>

                        </div>

                    </div>


                    <!-- DURATION -->

                    <div class="col-12 col-md-4">

                        <div class="course-info-box">

                            <div class="course-info-icon">

                                <MudIcon Icon="@Icons.Material.Filled.Schedule"
                                         Color="Color.Primary" />

                            </div>

                            <div>

                                <MudText Typo="Typo.body2"
                                         Color="Color.Secondary">

                                    Duration

                                </MudText>

                                <MudText Typo="Typo.h6"
                                         Class="fw-bold">

                                    @course.Duration Months

                                </MudText>

                            </div>

                        </div>

                    </div>


                    <!-- TEACHER -->

                    <div class="col-12 col-md-4">

                        <div class="course-info-box">

                            <div class="course-info-icon">

                                <MudIcon Icon="@Icons.Material.Filled.Person"
                                         Color="Color.Primary" />

                            </div>

                            <div>

                                <MudText Typo="Typo.body2"
                                         Color="Color.Secondary">

                                    Instructor

                                </MudText>

                                <MudText Typo="Typo.h6"
                                         Class="fw-bold">

                                    @GetTeacherName()

                                </MudText>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- INFORMATION MESSAGE -->

                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Text"
                          Class="mt-4">

                    Course information is managed by the institution.

                </MudAlert>

            </MudPaper>
        }

    </div>
}


<style>

    .my-courses-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .course-info-box {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 16px;
        height: 100%;
    }

    .course-info-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(25, 118, 210, 0.10);
        flex-shrink: 0;
    }

    .course-empty-icon {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(25, 118, 210, 0.10);
    }

</style>


@code {

    private MyCourseDto? course;

    private bool isLoading = true;


    protected override async Task OnInitializedAsync()
    {
        await LoadCourse();
    }


    private async Task LoadCourse()
    {
        try
        {
            isLoading = true;

            course =
                await StudentCourseService
                    .GetMyCourseAsync();
        }
        catch
        {
            Snackbar.Add(
                "Unable to load course information.",
                Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private string GetTeacherName()
    {
        if (course == null ||
            string.IsNullOrWhiteSpace(
                course.TeacherName))
        {
            return "Not assigned";
        }

        return course.TeacherName;
    }
}