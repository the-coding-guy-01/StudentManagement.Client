@page "/student/my-courses"

@layout StudentLayout

@using Microsoft.AspNetCore.Authorization
@using StudentManagement.Client.Models.StudentPortal
@using StudentManagement.Client.Services.Interfaces

@attribute [Authorize(Roles = "Student")]

@inject IStudentCourseService StudentCourseService
@inject ISnackbar Snackbar

<PageTitle>My Courses</PageTitle>

<main class="my-courses-page">
    <header class="courses-page-header">
        <div class="courses-heading-copy">
            <span class="courses-eyebrow">YOUR LEARNING</span>
            <MudText Typo="Typo.h3" Class="courses-page-title">My Courses</MudText>
            <MudText Typo="Typo.body1" Class="courses-page-subtitle">
                Keep track of your enrolled courses and the people guiding your studies.
            </MudText>
        </div>

        @if (!isLoading && string.IsNullOrEmpty(errorMessage) && courses.Count > 0)
        {
            <div class="courses-count-card" aria-label="Enrolled course count">
                <span class="courses-count-number">@courses.Count</span>
                <span class="courses-count-label">@(courses.Count == 1 ? "Enrolled course" : "Enrolled courses")</span>
            </div>
        }
    </header>

    @if (isLoading)
    {
        <MudPaper Elevation="0" Class="courses-state-card">
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3" Class="pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.body1" Class="courses-state-copy">Loading your courses...</MudText>
            </MudStack>
        </MudPaper>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudPaper Elevation="0" Class="courses-state-card courses-error-state">
            <div class="courses-state-icon courses-error-icon">
                <MudIcon Icon="@Icons.Material.Filled.CloudOff" />
            </div>
            <MudText Typo="Typo.h6" Class="courses-state-title">We couldn’t load your courses</MudText>
            <MudText Typo="Typo.body2" Class="courses-state-copy">Check your connection and try again.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadCourses"
                       Class="courses-retry-button">
                Try again
            </MudButton>
        </MudPaper>
    }
    else if (courses.Count == 0)
    {
        <MudPaper Elevation="0" Class="courses-state-card courses-empty-state">
            <div class="courses-state-icon">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
            </div>
            <MudText Typo="Typo.h5" Class="courses-state-title">Your learning journey starts here</MudText>
            <MudText Typo="Typo.body1" Class="courses-state-copy">
                You haven’t been assigned to any courses yet. Your courses will appear here once they’re available.
            </MudText>
            <div class="courses-empty-note">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                <span>Contact your school administrator if you think a course is missing.</span>
            </div>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="3" Class="courses-grid">
            @foreach (var course in courses)
            {
                <MudItem xs="12" lg="6">
                    <MudPaper Elevation="0" Class="course-card">
                        <div class="course-card-accent"></div>

                        <div class="course-card-content">
                            <div class="course-card-topline">
                                <div class="course-code-wrap">
                                    <span class="course-icon-wrap">
                                        <MudIcon Icon="@Icons.Material.Filled.AutoStories" />
                                    </span>
                                    <span class="course-code">@course.CourseCode</span>
                                </div>

                                <MudChip T="string" Size="Size.Small"
                                         Color="@(course.IsActive ? Color.Success : Color.Default)"
                                         Class="course-status-chip">
                                    @(course.IsActive ? "Active" : "Inactive")
                                </MudChip>
                            </div>

                            <MudText Typo="Typo.h5" Class="course-title">@course.CourseName</MudText>
                            <MudText Typo="Typo.body2" Class="course-description">
                                @(string.IsNullOrWhiteSpace(course.Description)
                                    ? "Course details will be provided by your institution."
                                    : course.Description)
                            </MudText>

                            <MudDivider Class="course-card-divider" />

                            <div class="course-details-grid">
                                <div class="course-detail">
                                    <span class="course-detail-icon"><MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" /></span>
                                    <div>
                                        <span class="course-detail-label">Credits</span>
                                        <span class="course-detail-value">@course.Credits</span>
                                    </div>
                                </div>

                                <div class="course-detail">
                                    <span class="course-detail-icon"><MudIcon Icon="@Icons.Material.Filled.Schedule" /></span>
                                    <div>
                                        <span class="course-detail-label">Duration</span>
                                        <span class="course-detail-value">@course.Duration @(course.Duration == 1 ? "month" : "months")</span>
                                    </div>
                                </div>

                                <div class="course-detail course-instructor">
                                    <span class="course-detail-icon"><MudIcon Icon="@Icons.Material.Filled.PersonOutline" /></span>
                                    <div>
                                        <span class="course-detail-label">Instructor</span>
                                        <span class="course-detail-value">@GetTeacherName(course)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <div class="courses-footer-note">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
            <MudText Typo="Typo.caption">Course information is managed by your institution.</MudText>
        </div>
    }
</main>

@code {
    private List<MyCourseDto> courses = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            courses = await StudentCourseService.GetMyCoursesAsync();
        }
        catch
        {
            errorMessage = "Unable to load course information.";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetTeacherName(MyCourseDto course)
    {
        return string.IsNullOrWhiteSpace(course.TeacherName)
            ? "Not assigned"
            : course.TeacherName;
    }
}
