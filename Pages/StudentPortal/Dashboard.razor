@page "/student-portal"

@layout StudentLayout

@attribute [Authorize(Roles = "Student")]

<PageTitle>Student Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <!-- Header -->
    <MudText Typo="Typo.h4" GutterBottom="true">
        Welcome back! 👋
    </MudText>

    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Here's what's happening with your studies.
    </MudText>


    <!-- Summary Cards -->
    <MudGrid Class="mb-6">

        <!-- Courses -->
        <MudItem xs="12" sm="4">
            <MudCard Elevation="1">
                <MudCardContent>

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="3">

                        <MudIcon Icon="@Icons.Material.Filled.MenuBook"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                My Courses
                            </MudText>

                            <MudText Typo="Typo.h5">
                                4
                            </MudText>
                        </div>

                    </MudStack>

                </MudCardContent>
            </MudCard>
        </MudItem>


        <!-- Attendance -->
        <MudItem xs="12" sm="4">
            <MudCard Elevation="1">
                <MudCardContent>

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="3">

                        <MudIcon Icon="@Icons.Material.Filled.BarChart"
                                 Color="Color.Success"
                                 Size="Size.Large" />

                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Attendance
                            </MudText>

                            <MudText Typo="Typo.h5">
                                85%
                            </MudText>
                        </div>

                    </MudStack>

                </MudCardContent>
            </MudCard>
        </MudItem>


        <!-- Assignments -->
        <MudItem xs="12" sm="4">
            <MudCard Elevation="1">
                <MudCardContent>

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="3">

                        <MudIcon Icon="@Icons.Material.Filled.Assignment"
                                 Color="Color.Warning"
                                 Size="Size.Large" />

                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Assignments
                            </MudText>

                            <MudText Typo="Typo.h5">
                                3
                            </MudText>
                        </div>

                    </MudStack>

                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>


    <!-- Main Content -->
    <MudGrid>

        <!-- Courses -->
        <MudItem xs="12" md="8">

            <MudCard Elevation="1">

                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            My Courses
                        </MudText>
                    </CardHeaderContent>

                    <CardHeaderActions>

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Href="/student-portal/courses">
                            View All
                        </MudButton>

                    </CardHeaderActions>
                </MudCardHeader>


                <MudCardContent>

                    <MudList>

                        <MudListItem>
                            <MudText Typo="Typo.body1">
                                Software Engineering
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary">
                                SE401
                            </MudText>

                            <MudChip Color="Color.Success"
                                     Size="Size.Small">
                                Active
                            </MudChip>
                        </MudListItem>


                        <MudListItem>
                            <MudText Typo="Typo.body1">
                                Database Systems
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary">
                                DB301
                            </MudText>

                            <MudChip Color="Color.Success"
                                     Size="Size.Small">
                                Active
                            </MudChip>
                        </MudListItem>


                        <MudListItem>
                            <MudText Typo="Typo.body1">
                                Web Development
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary">
                                WD302
                            </MudText>

                            <MudChip Color="Color.Success"
                                     Size="Size.Small">
                                Active
                            </MudChip>
                        </MudListItem>

                    </MudList>

                </MudCardContent>

            </MudCard>

        </MudItem>


        <!-- Announcements -->
        <MudItem xs="12" md="4">

            <MudCard Elevation="1">

                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            Announcements
                        </MudText>
                    </CardHeaderContent>

                    <CardHeaderActions>

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Href="/student-portal/announcements">
                            View All
                        </MudButton>

                    </CardHeaderActions>
                </MudCardHeader>


                <MudCardContent>

                    <MudStack Spacing="3">

                        <div>
                            <MudText Typo="Typo.subtitle2">
                                Semester Registration
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary">
                                Semester registration is now open.
                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">
                                Today
                            </MudText>
                        </div>


                        <MudDivider />


                        <div>
                            <MudText Typo="Typo.subtitle2">
                                Exam Registration
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary">
                                Check the examination registration deadline.
                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">
                                2 days ago
                            </MudText>
                        </div>

                    </MudStack>

                </MudCardContent>

            </MudCard>

        </MudItem>

    </MudGrid>

</MudContainer>