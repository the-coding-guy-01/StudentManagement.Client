@page "/courses/edit/{Id:int}"

@using StudentManagement.Client.Models.Courses
@using StudentManagement.Client.Models.Teachers
@using StudentManagement.Client.Services.Interfaces

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject ICourseService CourseService
@inject ITeacherService TeacherService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Edit Course</PageTitle>


<div class="container py-4">

    <div class="mx-auto" style="max-width: 900px;">

        @if (isLoading)
        {
            <div class="d-flex flex-column justify-content-center align-items-center gap-3"
                 style="min-height: 300px;">

                <MudProgressCircular Indeterminate="true"
                                     Color="Color.Primary" />

                <MudText>
                    Loading course...
                </MudText>

            </div>
        }
        else
        {
            <!-- Header -->
            <div class="mb-4">

                <MudText Typo="Typo.h4">
                    Edit Course
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">
                    Update the selected course.
                </MudText>

            </div>


            <!-- Form Card -->
            <MudPaper Elevation="1"
                      Class="p-4 rounded-4">

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <MudAlert Severity="Severity.Error"
                              Class="mb-4">
                        @errorMessage
                    </MudAlert>
                }


                <EditForm Model="@course"
                          OnValidSubmit="SaveCourse">

                    <DataAnnotationsValidator />


                    <MudGrid Spacing="3">

                        <!-- Course Code -->
                        <MudItem xs="12" md="6">

                            <MudTextField T="string"
                                          Label="Course Code"
                                          Value="@courseCode"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined"
                                          Style="width:100%;" />

                        </MudItem>


                        <!-- Course Name -->
                        <MudItem xs="12" md="6">

                            <MudTextField T="string"
                                          Label="Course Name"
                                          @bind-Value="course.CourseName"
                                          For="@(() => course.CourseName)"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Course name is required."
                                          Style="width:100%;" />

                        </MudItem>


                        <!-- Teacher -->
                        <MudItem xs="12" md="6">

                            <MudSelect T="int?"
                                       Label="Teacher"
                                       @bind-Value="course.TeacherId"
                                       Variant="Variant.Outlined"
                                       Clearable="true"
                                       Style="width:100%;">

                                @foreach (var teacher in teachers)
                                {
                                    <MudSelectItem T="int?"
                                                   Value="@((int?)teacher.Id)">

                                        @teacher.FirstName @teacher.LastName

                                    </MudSelectItem>
                                }

                            </MudSelect>

                        </MudItem>


                        <!-- Credits -->
                        <MudItem xs="12" md="6">

                            <MudNumericField T="int"
                                             Label="Credits"
                                             @bind-Value="course.Credits"
                                             Variant="Variant.Outlined"
                                             Min="1"
                                             Max="20"
                                             Style="width:100%;" />

                        </MudItem>


                        <!-- Duration -->
                        <MudItem xs="12" md="6">

                            <MudNumericField T="int"
                                             Label="Duration"
                                             @bind-Value="course.Duration"
                                             Variant="Variant.Outlined"
                                             Min="1"
                                             Max="120"
                                             Style="width:100%;" />

                        </MudItem>


                        <!-- Status -->
                        <MudItem xs="12" md="6">

                            <div class="d-flex flex-column justify-content-center"
                                 style="min-height: 56px;">

                                <MudText Typo="Typo.body2">
                                    Course Status
                                </MudText>

                                <MudSwitch T="bool"
                                           @bind-Value="course.IsActive"
                                           Color="Color.Primary"
                                           Label="Active" />

                            </div>

                        </MudItem>


                        <!-- Description -->
                        <MudItem xs="12">

                            <MudTextField T="string"
                                          Label="Description"
                                          @bind-Value="course.Description"
                                          Variant="Variant.Outlined"
                                          Lines="5"
                                          Style="width:100%;" />

                        </MudItem>

                    </MudGrid>


                    <!-- Actions -->
                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-end align-items-stretch align-items-sm-center gap-2 mt-4 pt-3 border-top">

                        <MudButton Variant="Variant.Text"
                                   Disabled="@isSaving"
                                   OnClick="Cancel">

                            Cancel

                        </MudButton>


                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@isSaving"
                                   StartIcon="@Icons.Material.Filled.Save">

                            @if (isSaving)
                            {
                                <MudProgressCircular Size="Size.Small"
                                                     Indeterminate="true"
                                                     Class="me-2" />

                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Update Course</span>
                            }

                        </MudButton>

                    </div>

                </EditForm>

            </MudPaper>
        }

    </div>

</div>


@code
{
    [Parameter]
    public int Id { get; set; }


    private UpdateCourseDto course = new();

    private List<TeacherDto> teachers = new();

    private string courseCode = string.Empty;

    private bool isLoading = true;

    private bool isSaving;

    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadCourse();
    }


    private async Task LoadCourse()
    {
        try
        {
            isLoading = true;


            teachers =
                await TeacherService.GetAllAsync();


            var existingCourse =
                await CourseService.GetByIdAsync(Id);


            if (existingCourse == null)
            {
                errorMessage =
                    "Course not found.";

                return;
            }


            courseCode =
                existingCourse.CourseCode;


            course = new UpdateCourseDto
            {
                CourseName =
                    existingCourse.CourseName,

                Description =
                    existingCourse.Description,

                Credits =
                    existingCourse.Credits,

                Duration =
                    existingCourse.Duration,

                IsActive =
                    existingCourse.IsActive,

                TeacherId =
                    existingCourse.TeacherId
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            errorMessage =
                "Course could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SaveCourse()
    {
        if (isSaving)
        {
            return;
        }


        try
        {
            isSaving = true;

            errorMessage = null;


            var updatedCourse =
                await CourseService.UpdateAsync(
                    Id,
                    course);


            if (updatedCourse == null)
            {
                errorMessage =
                    "Course could not be updated.";

                return;
            }


            Snackbar.Add(
                "Course updated successfully.",
                Severity.Success);


            Navigation.NavigateTo("/courses");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            errorMessage =
                "An error occurred while updating the course.";
        }
        finally
        {
            isSaving = false;
        }
    }


    private void Cancel()
    {
        Navigation.NavigateTo("/courses");
    }
}