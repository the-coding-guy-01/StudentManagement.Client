                                        <div>

                                            <div class="fw-semibold">
                                                View Courses
                                            </div>

                                            <small class="text-muted">
                                                Manage courses
                                            </small>

                                        </div>

                                    </div>

                                </button>

                            </div>


                            <!-- Add Course -->

                            <div class="col-12 col-md-6 col-xl-6">

                                <button class="btn btn-light
                                               border-0
                                               rounded-3
                                               text-start
                                               w-100 h-100
                                               p-3"
                                        @onclick="@(() => Navigation.NavigateTo("/courses/add"))">

                                    <div class="d-flex align-items-center gap-3">

                                        <MudIcon Icon="@Icons.Material.Filled.AddCircle"
                                                 Color="Color.Secondary" />

                                        <div>

                                            <div class="fw-semibold">
                                                Add Course
                                            </div>

                                            <small class="text-muted">
                                                Create course
                                            </small>

                                        </div>

                                    </div>

                                </button>

                            </div>


                            <!-- Teacher Course -->

                            <div class="col-12 col-md-6 col-xl-6">

                                <button class="btn btn-light
                                               border-0
                                               rounded-3
                                               text-start
                                               w-100 h-100
                                               p-3"
                                        @onclick="@(() => Navigation.NavigateTo("/teacher-course-assignment"))">

                                    <div class="d-flex align-items-center gap-3">

                                        <MudIcon Icon="@Icons.Material.Filled.Link"
                                                 Color="Color.Success" />

                                        <div>

                                            <div class="fw-semibold">
                                                Teacher-Course
                                            </div>

                                            <small class="text-muted">
                                                Assign teachers
                                            </small>

                                        </div>

                                    </div>

                                </button>

                            </div>


                            <!-- Student Course -->

                            <div class="col-12 col-md-6 col-xl-6">

                                <button class="btn btn-light
                                               border-0
                                               rounded-3
                                               text-start
                                               w-100 h-100
                                               p-3"
                                        @onclick="@(() => Navigation.NavigateTo("/student-course-enrollment"))">

                                    <div class="d-flex align-items-center gap-3">

                                        <MudIcon Icon="@Icons.Material.Filled.GroupAdd"
                                                 Color="Color.Secondary" />

                                        <div>

                                            <div class="fw-semibold">
                                                Student-Course
                                            </div>

                                            <small class="text-muted">
                                                Enroll students
                                            </small>

                                        </div>

                                    </div>

                                </button>

                            </div>


                        </div>

                    </div>

                </div>

            </div>


        </div>

    </div>
}



@code {

    private DashboardDto? dashboard;

    private bool isLoading = true;

    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }


    private async Task LoadDashboard()
    {
        try
        {
            isLoading = true;

            errorMessage = null;

            dashboard = await DashboardService.GetDashboardAsync();

            if (dashboard is null)
            {
                errorMessage = "Unable to load dashboard data.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            errorMessage =
                "An error occurred while loading the dashboard.";
        }
        finally
        {
            isLoading = false;
        }
    }



    // ===============================
    // STUDENT ACTIVE PERCENTAGE
    // ===============================

    private int StudentActivePercentage
    {
        get
        {
            if (dashboard is null ||
                dashboard.TotalStudents == 0)
            {
                return 0;
            }

            return (int)Math.Round(
                (double)dashboard.ActiveStudents
                / dashboard.TotalStudents
                * 100);
        }
    }



    // ===============================
    // COURSE ACTIVE PERCENTAGE
    // ===============================

    private int CourseActivePercentage
    {
        get
        {
            if (dashboard is null ||
                dashboard.TotalCourses == 0)
            {
                return 0;
            }

            return (int)Math.Round(
                (double)dashboard.ActiveCourses
                / dashboard.TotalCourses
                * 100);
        }
    }



    // ===============================
    // BAR CHART
    // ===============================

    private string GetBarStyle(int value)
    {
        if (dashboard is null)
        {
            return "width:70px;height:5px;";
        }

        var maximum = Math.Max(
            dashboard.TotalStudents,
            Math.Max(
                dashboard.TotalTeachers,
                dashboard.TotalCourses));

        if (maximum == 0)
        {
            return "width:70px;height:5px;";
        }

        var percentage =
            (double)value / maximum * 100;

        var height = Math.Max(
            5,
            percentage * 2.1);

        return $"width:70px;height:{height}px;";
    }



    // ===============================
    // STUDENT DONUT
    // ===============================

    private string GetStudentDonutStyle()
    {
        return
            $"width:170px;" +
            $"height:170px;" +
            $"background:conic-gradient(" +
            $"#0d6efd 0% {StudentActivePercentage}%," +
            $"#6f42c1 {StudentActivePercentage}% 100%);";
    }



    // ===============================
    // COURSE DONUT
    // ===============================

    private string GetCourseDonutStyle()
    {
        return
            $"width:170px;" +
            $"height:170px;" +
            $"background:conic-gradient(" +
            $"#6f42c1 0% {CourseActivePercentage}%," +
            $"#dee2e6 {CourseActivePercentage}% 100%);";
    }



    // ===============================
    // STUDENT INITIAL
    // ===============================

    private string GetInitial(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return name
            .Trim()
            .Substring(0, 1)
            .ToUpper();
    }
}